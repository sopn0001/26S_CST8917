# Copy to .env and fill in, or let infra/provision.sh generate it for you.
#
# The demos authenticate with your Azure AD identity (az login) via
# DefaultAzureCredential — no keys in this file. The Service Bus and Event
# Hubs namespaces have local (SAS) auth disabled, so a signed-in identity
# with the right data roles is required.

# ---- Storage Queues -------------------------------------------------------
STORAGE_ACCOUNT_URL=https://<storage_account_name>.queue.core.windows.net
RECEIPT_QUEUE=receipts

# ---- Service Bus ----------------------------------------------------------
SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net
ORDER_QUEUE=orders

# ---- Event Hubs -----------------------------------------------------------
EVENTHUB_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=telemetry
EVENTHUB_CONSUMER_GROUP=$Default
