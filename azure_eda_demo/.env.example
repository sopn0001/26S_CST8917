# Copy to .env and fill in, or let infra/provision.sh generate it for you.
#
# These are connection strings with embedded keys, which is fine for a
# classroom demo. In production use managed identity + DefaultAzureCredential
# and never put a key in a file.

# ---- Storage: receipt queue, Event Hubs checkpoints, EG dead letters -------
STORAGE_CONNECTION_STRING=
RECEIPT_QUEUE=receipts
CHECKPOINT_CONTAINER=checkpoints

# ---- Service Bus ----------------------------------------------------------
SERVICEBUS_CONNECTION_STRING=
ORDER_QUEUE=orders
SESSION_QUEUE=orders-sessions
STATUS_TOPIC=order-status
NOTIFY_SUBSCRIPTION=notify
AUDIT_SUBSCRIPTION=audit

# ---- Event Hubs -----------------------------------------------------------
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=telemetry
EVENTHUB_CONSUMER_GROUP=$Default

# ---- Event Grid -----------------------------------------------------------
EVENTGRID_TOPIC_ENDPOINT=
EVENTGRID_TOPIC_KEY=
